# Обязательно
BOT_TOKEN=
GEMINI_API_KEY=            # ключ из aistudio.google.com (подписка Google AI Plus API не даёт)

# Необязательно
# Ещё ключи Gemini (из других аккаунтов): либо GEMINI_API_KEY_2…_9, либо одним списком через запятую.
# Бот делит запросы между ключами по кругу и, если один упёрся в лимит, берёт следующий.
GEMINI_API_KEY_2=
GEMINI_API_KEYS=
# Groq (console.groq.com/keys; это не Grok от xAI): запасной мозг и Whisper для голосовых.
# Можно несколько ключей: GROQ_API_KEY_2…_9 или GROQ_API_KEYS=через,запятую
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROK_API_KEY=              # ключ xAI; без него подколы тоже пойдут через Gemini
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemma-4-26b-a4b-it,gemini-3.1-flash-lite,gemini-3.8-flash   # через запятую: основная и запасные
GROK_MODEL=grok-4-fast     # проверь актуальное имя модели в консоли xAI
GEMINI_SMART_MODEL=gemini-3.5-flash   # для прямых вопросов
WAKE_HOUR=9                # во сколько здороваться
QUIET_FROM=0               # ночная тишина с … (по BOT_TZ)
QUIET_TO=8                 # … до
BOT_ALIASES=бот            # слова-обращения через запятую, например: бот,бобби
BOT_TZ=Europe/Moscow       # часовой пояс для «итогов дня»
DIGEST_HOUR=22             # во сколько присылать итоги дня
DATA_DIR=./data            # на Railway: примонтируй Volume в /data и поставь DATA_DIR=/data
AI_RPM=12                 # общий лимит запросов к ИИ в минуту
ROAST_COOLDOWN_HOURS=3     # как часто можно подкалывать одного человека
MEDIA_ENABLED=1          # 0 — не разбирать голосовые и фото
MEDIA_PER_HOUR=15          # лимит разборов медиа в час на чат
WIT_JUDGE=0               # 1 — отдельный запрос-редактор выбирает лучшую шутку (в 2 раза больше запросов)
ADMIN_IDS=               # числовые Telegram-ID админов через запятую (надёжнее ника)
ADMIN_USERNAME=vladik4638  # пока ADMIN_IDS пуст: этот ник при первом /admin в личке станет админом (ID запомнится)
# Дополнительные провайдеры (все необязательные; можно несколько ключей через запятую)
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
# или любой сервис с OpenAI-совместимым API: имя|https://хост/v1|ключ|модель1,модель2; следующий…
EXTRA_LLMS=
# Режим «молчун»: по умолчанию бот сам в чат не пишет (только отвечает, когда позвали, и кидает графики света). 1 — вернуть самостоятельность
SELF_TALK=0
# Графики отключений света (https://github.com/Baskerville42/outage-data-ua): регион dnipro | kyiv | kyiv-region | odesa
OUTAGE_REGION=dnipro
OUTAGE_HOUR=7              # во сколько утром кидать график (по BOT_TZ)
OUTAGE_EVENING_HOUR=20     # во сколько вечером кидать график на завтра
OUTAGE_TZ=Europe/Kyiv      # пояс графика света (по умолчанию Киев, не зависит от BOT_TZ)
